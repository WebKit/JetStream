Backport of the SQLite 3.49.0 fix for building with Emscripten 4.0 or newer.

Since Emscripten 4.0.0 (emscripten-core/emscripten#23157), the -sMODULARIZE
factory awaits the Wasm instantiation and runs Module.postRun before any
--post-js code executes. SQLite 3.48.0 registers its API setup as a
Module.postRun handler in post-js-header.js, so with Emscripten 4+ that
handler never runs and sqlite3InitModule() fails with "s is undefined".
SQLite 3.49.0 replaced the handler with Module.runSQLite3PostLoadInit(),
which extern-post-js.c-pp.js calls once the factory promise resolves.
Remove this patch when updating to SQLite 3.49.0 or newer.

--- a/ext/wasm/api/post-js-header.js
+++ b/ext/wasm/api/post-js-header.js
@@ -7,8 +7,7 @@
    installs will be run after the WASM module is loaded, at which
    point the sqlite3 JS API bits will get set up.
 */
-if(!Module.postRun) Module.postRun = [];
-Module.postRun.push(function(Module/*the Emscripten-style module object*/){
+Module.runSQLite3PostLoadInit = function(Module/*the Emscripten-style module object*/){
   'use strict';
   /* This function will contain at least the following:
 
--- a/ext/wasm/api/post-js-footer.js
+++ b/ext/wasm/api/post-js-footer.js
@@ -1,4 +1,4 @@
 /* The current function scope was opened via post-js-header.js, which
    gets prepended to this at build-time. This file closes that
    scope. */
-})/*postRun.push(...)*/;
+}/*Module.runSQLite3PostLoadInit()*/;
--- a/ext/wasm/api/extern-post-js.c-pp.js
+++ b/ext/wasm/api/extern-post-js.c-pp.js
@@ -75,6 +75,7 @@
       }
 //#endif
       //console.warn("sqlite3InitModule() returning sqlite3 object.");
+      EmscriptenModule.runSQLite3PostLoadInit(EmscriptenModule);
       const s = EmscriptenModule.sqlite3;
       s.scriptInfo = initModuleState;
       //console.warn("sqlite3.scriptInfo =",s.scriptInfo);
